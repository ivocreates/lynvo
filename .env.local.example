# Local development: `npm run dev` reads bindings (D1 "DB", R2 "MEDIA") from
# wrangler.toml and secrets from .dev.vars (gitignored):
#
#   BETTER_AUTH_SECRET=<32+ random characters>
#   APP_URL=http://localhost:3000
#
# Production: set these as Worker variables / secrets in Cloudflare.
RESEND_API_KEY=
CONTACT_NOTIFICATION_TO=
EMAIL_FROM="LYNVO <notifications@lynvo.studio>"
SITE_URL=https://lynvo.studio
APP_URL=https://app.lynvo.studio
STUDIO_URL=https://lynvo.studio
TECH_URL=https://lynvo.tech
SPLIT_DOMAINS=
