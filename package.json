{
  "name": "lynvo-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:cf": "opennextjs-cloudflare build",
    "deploy:cf": "opennextjs-cloudflare build && wrangler deploy",
    "preview:cf": "opennextjs-cloudflare build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply lynvo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lynvo-db --remote",
    "db:export-supabase": "node scripts/migrate-from-supabase.mjs",
    "db:import:remote": "wrangler d1 execute lynvo-db --remote --file migration-data.sql",
    "dev:worker": "opennextjs-cloudflare build && wrangler dev --port 8787"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.25",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "kysely": "^0.29.9",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^0.454.0",
    "next": "14.2.35",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "sonner": "^1.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.15.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "pg": "^8.16.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "wrangler": "^4.15.0"
  }
}
